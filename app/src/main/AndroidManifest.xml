<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed on Android 11+ to see whether Minecraft is installed and to
         open it. Without this the package is invisible to us. -->
    <queries>
        <package android:name="com.mojang.minecraftpe" />
    </queries>

    <application
        android:name=".VelaApplication"
        android:appComponentFactory=".VelaComponentFactory"
        android:allowBackup="false"
        android:label="Vela"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vela">

        <!-- Declared, not started by the system: Android needs a component to
             host, and this is the name the game uses. The class itself comes from
             the installed APK, not from this one. -->
        <activity
            android:name="com.mojang.minecraftpe.MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Vela">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
